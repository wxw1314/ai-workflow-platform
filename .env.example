# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Full Stack FastAPI Project"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@47.98.127.118:5432/mydb


# Embedding model

DASHSCOPE_API_KEY = your-DASHSCOPE_API_KEY
DASHSCOPE_WORKSPACE_ID=changethis


# Milvus
MILVUS_URI=url
MILVUS_TOKEN=

# Baiyou Chat Model
BAIYOU_API_KEY=your-BAIYOU_API_KEY
BAIYOU_BASE_URL=https://api.baoyouhuyu.com/v1
BAIYOU_MODEL=claude-opus-4-7


# langFuse
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_SECRET_KEY=your-LANGFUSE_SECRET_KEY
LANGFUSE_PUBLIC_KEY="your-LANGFUSE_PUBLIC_KEY
LANGFUSE_BASE_URL="https://jp.cloud.langfuse.com"